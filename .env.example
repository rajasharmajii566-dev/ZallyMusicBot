# Copy this file to .env and fill in your values.
# Get API_ID and API_HASH from https://my.telegram.org/apps
API_ID=
API_HASH=

# Get bot token from @BotFather on Telegram
BOT_TOKEN=

# Logging group id (numeric, must start with -100... for supergroups/channels)
# Add your bot AND assistant as admins of this group.
# (alias: LOG_GROUP_ID also works)
LOGGER_ID=

# MongoDB connection string from https://cloud.mongodb.com
# (alias: MONGO_URI also works)
MONGO_DB_URI=

# Your Telegram user id (get from @MissRose_bot or any /id bot)
OWNER_ID=

# Pyrogram v2 user-account string session from @StringFatherBot
STRING_SESSION=

# Optional
ENCRYPTION_KEY=

# Optional - paid YouTube backend. NOT required: the bot falls back to yt-dlp.
YT_API_KEY=
YTPROXY_URL=

# STRONGLY RECOMMENDED for Railway / any datacenter host.
# YouTube blocks downloads from datacenter IPs with "Sign in to confirm you're
# not a bot". Paste the full contents of a Netscape-format cookies.txt exported
# from a logged-in YouTube account (see README "YouTube cookies" section).
# Alternatively, just drop the file at cookies/cookies.txt.
COOKIES=
# Base64-encoded contents of the same cookies.txt. Use this instead of COOKIES
# if your host mangles newlines. Generate with:
#   base64 -w0 cookies.txt        (Linux)   |   base64 -i cookies.txt (macOS)
COOKIES_BASE64=

# Optional but very effective on blocked datacenter IPs: route yt-dlp through a
# residential/rotating proxy. Any http(s)/socks5 URL works.
# e.g. YT_PROXY=http://user:pass@host:port  or  socks5://host:port
YT_PROXY=

# ---- Automatic fallback when YouTube blocks this server's IP ----------------
# You normally do NOT need to touch anything here. When YouTube answers with
# "Sign in to confirm you're not a bot", the bot recovers on its own by
#   (a) downloading the EXACT YouTube audio through an auto-discovered pool of
#       free HTTP proxies (speed-ranked, multi-connection), and
#   (b) in parallel, searching SoundCloud with the song title as a safety net.
# YouTube is preferred: it gets FALLBACK_HEAD_START seconds to finish before
# SoundCloud may win. Tune only if you want to.
#
# Free-proxy pool (default: enabled)
PROXY_POOL_ENABLED=1
# How many candidate proxies to test per scan, and how many to keep
PROXY_SCAN_LIMIT=400
PROXY_POOL_TARGET=12
# How many pooled proxies to try for a single download, and how many race at once
PROXY_MAX_TRIES=8
PROXY_RACE=4
# aria2c multi-connection download (used automatically when aria2c is installed)
ARIA2_CONNECTIONS=16
# SoundCloud fallback (default: enabled)
SOUNDCLOUD_FALLBACK=1
# Minimum title similarity (0-1) before a SoundCloud result is accepted
SOUNDCLOUD_MIN_MATCH=0.5
# Seconds the YouTube-proxy path gets before SoundCloud may win (0 = pure race)
FALLBACK_HEAD_START=30

# Optional - Heroku deployment (only if deploying to Heroku)
HEROKU_API_KEY=
HEROKU_APP_NAME=

# Optional - Spotify (for Spotify links)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Support / Updates links shown on buttons and in messages
SUPPORT_CHANNEL=https://t.me/rajamods7_ontop
SUPPORT_CHAT=https://t.me/rajamods7_ontop

# Optional - Auto-update from upstream repo
UPSTREAM_REPO=
UPSTREAM_BRANCH=main
GIT_TOKEN=
